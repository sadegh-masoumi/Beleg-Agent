# Copy to .env (git-ignored): cp .env.example .env
# Never commit real keys. In CI use GitHub Actions secrets.

POSTGRES_DB=beleg
POSTGRES_USER=beleg
POSTGRES_PASSWORD=beleg-dev-only

MINIO_ROOT_USER=beleg-minio
MINIO_ROOT_PASSWORD=beleg-minio-dev-only
S3_BUCKET=belege

# Gemini (the only LLM provider). Key from https://aistudio.google.com/apikey
# Free tier: inputs may be reviewed by humans and used to improve Google products.
# Use the free tier only with public datasets; real receipts need the paid tier.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Stronger model, used only when validation of the cheap model's result fails (tiered routing)
GEMINI_STRONG_MODEL=gemini-3.8-flash
# Image token budget per page: LOW, MEDIUM, HIGH (OCR quality usually saturates at MEDIUM)
GEMINI_MEDIA_RESOLUTION=MEDIUM
# Reasoning effort: MINIMAL, LOW, MEDIUM, HIGH, or empty for the model default
GEMINI_THINKING_LEVEL=

# Cluster-wide model rate limits in requests per minute, shared by all workers (0 = unlimited).
# Set them to your key's quota (AI Studio shows it), e.g. GEMINI_STRONG_RPM=5 for gemini-3.8-flash on the free tier.
GEMINI_RPM=0
GEMINI_STRONG_RPM=0

# Worker: documents in parallel per worker, attempts before DEAD_LETTER
BELEG_WORKER_CONCURRENCY=4
BELEG_WORKER_MAX_ATTEMPTS=5

# Agent: send validator errors back to GEMINI_STRONG_MODEL once (false only to measure the baseline)
BELEG_SELF_CORRECTION=true
# Chart of accounts for account suggestions: SKR03 or SKR04
BELEG_CHART_OF_ACCOUNTS=SKR03

# Host ports (shifted to avoid clashes with other local projects)
API_HOST_PORT=18080
WORKER_HOST_PORT=18081
POSTGRES_HOST_PORT=15432
MINIO_API_HOST_PORT=19000
MINIO_CONSOLE_HOST_PORT=19001
